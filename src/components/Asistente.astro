  .asis__opcion::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--tinta); scale: 0 1; transform-origin: left; transition: scale .45s cubic-bezier(.2, .8, .2, 1); }
  .asis__opcion-num { align-self: start; padding-top: .55rem; color: var(--tinta); font-size: .8rem; font-weight: 700; letter-spacing: .08em; transition: color .3s ease; }
