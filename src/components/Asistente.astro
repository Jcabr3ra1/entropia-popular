  .asis__titulos h2 { margin: 0; color: var(--ink); font: 700 clamp(1.5rem, 3vw, 1.9rem)/1.15 var(--font-display); }
  .asis__cerrar { width: 44px; height: 44px; display: grid; place-items: center; padding: 0; border: 1px solid var(--border); border-radius: 50%; color: var(--ink); background: var(--white); }
  .asis__cerrar:hover { color: var(--white); background: var(--ink); }

  .asis__progreso { grid-column: 1 / -1; margin-top: .35rem; }
  .asis__progreso p { margin: 0 0 .55rem; color: var(--text-soft); font-size: .82rem; }
  .asis__progreso p span:first-child { color: var(--ink); font-weight: 600; }
  .asis__linea { height: 3px; overflow: hidden; border-radius: 3px; background: var(--border); }
  .asis__linea span { display: block; height: 100%; background: linear-gradient(90deg, var(--red), var(--leaf), var(--blue)); transform-origin: left; scale: .3333 1; transition: scale .45s cubic-bezier(.2, .8, .2, 1); }

  .asis__cuerpo { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 1.5rem 1.75rem; }
  .asis__paso { display: grid; gap: 1.25rem; }
  .asis__paso[hidden] { display: none; }

  /* Paso 1 */
  /* Opciones como filas editoriales (mismo lenguaje que el menú curvo y el catálogo) */
  .asis__opciones { display: grid; border-top: 1px solid var(--border); }
