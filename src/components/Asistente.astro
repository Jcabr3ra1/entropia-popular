  .contador--grande { width: fit-content; }
  .contador--grande button { width: 52px; height: 52px; }
  .contador--grande input { width: 3.5rem; font-size: 1.4rem; }

  /* Catálogo */
  /* Tienda dentro del asistente: el panel se ensancha en este paso */
  .asis.is-tienda { width: min(100%, 940px); }
  .filtros-asis { display: flex; flex-wrap: wrap; gap: .25rem 1.4rem; margin-top: .25rem; border-bottom: 1px solid var(--border); }
  .filtros-asis button { position: relative; min-height: 44px; padding: .4rem 0; border: 0; color: var(--text-soft); background: none; cursor: pointer; font: 700 1rem/1.2 var(--font-display); }
  .filtros-asis span { color: var(--red-deep); font: 600 .72rem/1 var(--font-body); vertical-align: .3em; }
  .filtros-asis button::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; border-radius: 3px; background: var(--red); scale: 0 1; transition: scale .25s cubic-bezier(.2, .8, .2, 1); }
  .filtros-asis button:hover, .filtros-asis button[aria-pressed='true'] { color: var(--ink); }
  .filtros-asis button[aria-pressed='true']::after { scale: 1 1; }

  .catalogo-asis h3 { margin: .75rem 0 .9rem; padding-bottom: .4rem; border-bottom: 2px solid var(--ink); color: var(--ink); font-size: .85rem; font-weight: 700; }
  .catalogo-asis[hidden], .planta[hidden] { display: none; }
  .tienda-asis { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 1.6rem 1.25rem; margin: 0; padding: 0; list-style: none; }
  .planta { display: flex; flex-direction: column; }
  .planta__foto { margin: 0; }
  .planta__foto :global(img), .planta__sinfoto { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; border-radius: var(--radius-sm); object-fit: cover; background: var(--leaf-soft); }
