---
import { Image } from 'astro:assets';
import logo from '../assets/logo-la-canada-reverdece.png';

interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a class:list={['brand', { 'brand--light': light }]} href={Astro.url.pathname === '/' ? '#inicio' : '/#inicio'} aria-label="La Cañada Reverdece, volver al inicio">
  <Image src={logo} width={400} widths={[200, 400]} sizes="200px" format="png" alt="" loading="eager" class="brand__image" />
</a>
<style>
  .brand { width: 160px; flex: 0 0 auto; display: block; text-decoration: none; }
  .brand__image { width: 100%; height: auto; }
  @media (max-width: 560px) { .brand { width: 130px; } }
</style>
